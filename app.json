{
  "expo": {
    "name": "Rewrite AI",
    "slug": "rewrite-ai-expo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/rewrite-app-icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F4",
        "foregroundImage": "./assets/rewrite-icon-foreground.png",
        "monochromeImage": "./assets/rewrite-icon-foreground.png"
      },
      "package": "com.aniket6234.rewriteai"
    },
    "web": {
      "favicon": "./assets/rewrite-app-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "scheme": "rewrite-ai",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2277aed9-e961-4e23-8749-ec29e2daa179"
      }
    },
    "owner": "aniket-6234"
  }
}
